{
  "name": "@asamarts/alint",
  "version": "0.22.1",
  "description": "Language-agnostic linter for repository structure, file existence, filename conventions, and file content rules. Runs the native alint binary from the matching @asamarts/alint-<os>-<cpu> package.",
  "keywords": ["lint", "linter", "repository", "filename", "policy", "compliance"],
  "homepage": "https://github.com/asamarts/alint",
  "bugs": "https://github.com/asamarts/alint/issues",
  "license": "(Apache-2.0 OR MIT)",
  "repository": {
    "type": "git",
    "url": "https://github.com/asamarts/alint.git",
    "directory": "npm"
  },
  "bin": {
    "alint": "bin/alint.js"
  },
  "files": [
    "bin/alint.js",
    "platforms.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@asamarts/alint-linux-x64": "0.22.1",
    "@asamarts/alint-linux-arm64": "0.22.1",
    "@asamarts/alint-darwin-x64": "0.22.1",
    "@asamarts/alint-darwin-arm64": "0.22.1",
    "@asamarts/alint-win32-x64": "0.22.1",
    "@asamarts/alint-win32-arm64": "0.22.1"
  }
}

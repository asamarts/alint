// GENERATED by `cargo run -p xtask -- gen-model`. Do not edit by hand.
// Source: docs/rules.md (## family / ### kind). `gen-model --check` gates it.
//
// The rule-kind taxonomy: 13 built-in rule families and the 82 canonical
// rule kinds within them (aliases ride on their canonical kind). Composes into
// the LikeC4 workspace; the 'Rule catalogue' view + Mermaid export for GitHub.

specification {
  element catalogue
  element family
  element ruleKind
}

model {
  ruleCatalogue = catalogue 'Rule catalogue' 'alint built-in rule kinds, grouped by family' {
    existence = family 'Existence' {
      file_exists = ruleKind 'file_exists'
      file_absent = ruleKind 'file_absent'
      dir_exists = ruleKind 'dir_exists'
      dir_absent = ruleKind 'dir_absent'
    }
    content = family 'Content' {
      file_content_matches = ruleKind 'file_content_matches'
      file_content_forbidden = ruleKind 'file_content_forbidden'
      file_header = ruleKind 'file_header'
      file_starts_with = ruleKind 'file_starts_with'
      file_ends_with = ruleKind 'file_ends_with'
      file_hash = ruleKind 'file_hash'
      file_max_size = ruleKind 'file_max_size'
      file_min_size = ruleKind 'file_min_size'
      file_min_lines = ruleKind 'file_min_lines'
      file_max_lines = ruleKind 'file_max_lines'
      file_footer = ruleKind 'file_footer'
      file_shebang = ruleKind 'file_shebang'
      file_is_text = ruleKind 'file_is_text'
      file_is_ascii = ruleKind 'file_is_ascii'
    }
    structured_query = family 'Structured query' {
      json_path_equals = ruleKind 'json_path_equals'
      yaml_path_equals = ruleKind 'yaml_path_equals'
      toml_path_equals = ruleKind 'toml_path_equals'
      xml_path_equals = ruleKind 'xml_path_equals'
      json_path_matches = ruleKind 'json_path_matches'
      yaml_path_matches = ruleKind 'yaml_path_matches'
      toml_path_matches = ruleKind 'toml_path_matches'
      xml_path_matches = ruleKind 'xml_path_matches'
      json_path_absent = ruleKind 'json_path_absent'
      yaml_path_absent = ruleKind 'yaml_path_absent'
      toml_path_absent = ruleKind 'toml_path_absent'
      xml_path_absent = ruleKind 'xml_path_absent'
      json_schema_passes = ruleKind 'json_schema_passes'
    }
    naming = family 'Naming' {
      filename_case = ruleKind 'filename_case'
      filename_regex = ruleKind 'filename_regex'
    }
    text_hygiene = family 'Text hygiene' {
      no_trailing_whitespace = ruleKind 'no_trailing_whitespace'
      final_newline = ruleKind 'final_newline'
      line_endings = ruleKind 'line_endings'
      line_max_width = ruleKind 'line_max_width'
      indent_style = ruleKind 'indent_style'
      max_consecutive_blank_lines = ruleKind 'max_consecutive_blank_lines'
    }
    security_unicode_sanity = family 'Security / Unicode sanity' {
      no_merge_conflict_markers = ruleKind 'no_merge_conflict_markers'
      no_bidi_controls = ruleKind 'no_bidi_controls'
      no_zero_width_chars = ruleKind 'no_zero_width_chars'
    }
    encoding = family 'Encoding' {
      no_bom = ruleKind 'no_bom'
    }
    structure = family 'Structure' {
      max_directory_depth = ruleKind 'max_directory_depth'
      max_files_per_directory = ruleKind 'max_files_per_directory'
      no_empty_files = ruleKind 'no_empty_files'
    }
    portable_metadata = family 'Portable metadata' {
      no_case_conflicts = ruleKind 'no_case_conflicts'
      no_illegal_windows_names = ruleKind 'no_illegal_windows_names'
    }
    unix_metadata = family 'Unix metadata' {
      no_symlinks = ruleKind 'no_symlinks'
      executable_bit = ruleKind 'executable_bit'
      executable_has_shebang = ruleKind 'executable_has_shebang'
      shebang_has_executable = ruleKind 'shebang_has_executable'
    }
    git_hygiene = family 'Git hygiene' {
      no_submodules = ruleKind 'no_submodules'
      commented_out_code = ruleKind 'commented_out_code'
      markdown_paths_resolve = ruleKind 'markdown_paths_resolve'
      git_no_denied_paths = ruleKind 'git_no_denied_paths'
      git_commit_message = ruleKind 'git_commit_message'
      git_commit_signed_off = ruleKind 'git_commit_signed_off'
      git_commit_no_fixup = ruleKind 'git_commit_no_fixup'
      git_commit_subject_matches = ruleKind 'git_commit_subject_matches'
      git_commit_author_allowlist = ruleKind 'git_commit_author_allowlist'
      git_commit_gpg_signed = ruleKind 'git_commit_gpg_signed'
      git_blame_age = ruleKind 'git_blame_age'
      changeset_requires_path = ruleKind 'changeset_requires_path'
      pair_changed_together = ruleKind 'pair_changed_together'
    }
    cross_file = family 'Cross-file' {
      pair = ruleKind 'pair'
      pair_hash = ruleKind 'pair_hash'
      registry_paths_resolve = ruleKind 'registry_paths_resolve'
      cross_file = ruleKind 'cross_file'
      file_graph = ruleKind 'file_graph'
      ordered_block = ruleKind 'ordered_block'
      for_each_match = ruleKind 'for_each_match'
      generated_file_fresh = ruleKind 'generated_file_fresh'
      import_gate = ruleKind 'import_gate'
      command_idempotent = ruleKind 'command_idempotent'
      for_each_dir = ruleKind 'for_each_dir'
      for_each_file = ruleKind 'for_each_file'
      dir_contains = ruleKind 'dir_contains'
      dir_only_contains = ruleKind 'dir_only_contains'
      unique_by = ruleKind 'unique_by'
      every_matching_has = ruleKind 'every_matching_has'
    }
    plugin_tier_1 = family 'Plugin (tier 1)' {
      command = ruleKind 'command'
    }
  }
}


// alint:architecture model (LikeC4).
//
// Single source of truth for the architecture diagrams rendered interactively
// on alint.org (/docs/about/architecture/) and exported to Mermaid for GitHub
// (`likec4 gen mermaid`). Hand-authored architectural INTENT (C4 levels 1-3 +
// behavioral/dynamic views). Code-derived fragments:the crate dependency
// graph, the rule-family taxonomy, and the config-DSL domain model:are
// generated by xtask into sibling `*.gen.c4` files and gated by `gen --check`.
//
// Migrated from docs/design/architecture/workspace.dsl (Structurizr C4).
// `likec4 validate` gates this model in CI; a vocabulary check asserts the
// element ids below stay a subset of alint's canonical sets (facts.json).

specification {
  element actor
  element system
  element container
  element crate

  tag external
  tag generated
}

model {
  dev = actor 'Developer' 'Authors .alint.yml, runs alint locally and fixes findings.'
  ci  = actor 'CI / GitHub Actions' 'Runs alint as a pipeline gate and via the official Action.'

  repo = system 'Linted repository' 'The target repo: files, structure, git history.' {
    #external
  }
  registries = system 'Package registries' 'crates.io, npm, ghcr.io, Homebrew (distribution channels).' {
    #external
  }
  site = system 'alint.org' 'Docs + marketing site; consumes the docs bundle (schema.json, facts.json, the model).' {
    #external
  }
  editor = system 'Editor' 'VS Code, JetBrains, Zed, Neovim, ... via the LSP.' {
    #external
  }
  codescan = system 'GitHub Code Scanning' 'Ingests SARIF; renders PR + security-tab annotations.' {
    #external
  }
  docsbundle = system 'docs-bundle branch' 'The orphan-branch handoff the alint.org build pulls.' {
    #external
  }

  alint = system 'alint' 'Repository linter: structure, existence, content, cross-file, git, and structured-query rules.' {

    cli = container 'CLI' 'The alint binary (cargo install alint): arg parsing, subcommand dispatch, the engine, report formatting.' {
      alintBin = crate 'alint'        'Binary entrypoint: CLI parsing, subcommand dispatch, process exit codes.'
      core     = crate 'alint-core'   'Engine, file walker, Rule trait, config AST, facts, errors, the foundation.'
      dsl      = crate 'alint-dsl'    'YAML config loader, schema validation, bundled rulesets, extends/SRI.'
      rules    = crate 'alint-rules'  'Built-in rule implementations + fixers across all dispatch classes.'
      output   = crate 'alint-output' 'Report formatters: human, json, sarif, github, gitlab, junit, markdown, agent.'
    }

    lspServer = container 'LSP server' 'The alint lsp mode: a Language Server over stdio for editor integrations.' {
      lspd = crate 'alint-lsp' 'Language Server Protocol server (diagnostics, validation) over stdio.'
    }

    tooling = container 'Dev + build tooling' 'Workspace-internal crates: benchmarks, test harness, end-to-end scenarios, cargo-xtask automation.' {
      bench   = crate 'alint-bench'   'Criterion micro-benchmarks and the seeded deterministic tree generator.'
      testkit = crate 'alint-testkit' 'Tree-spec materializer, scenario runner, and proptest strategies for tests.'
      e2e     = crate 'alint-e2e'     'End-to-end scenarios plus the coverage-audit and invariant tests.'
      xtask   = crate 'xtask'         'Build automation: bench-release, docs-export, gen-schema, gen-facts, gen-arch.'
    }
  }

  // --- Context relationships (C4 level 1) ---
  dev -> alintBin 'runs alint check / fix'
  dev -> lspd 'gets inline diagnostics in the editor'
  ci  -> alintBin 'runs as a pipeline gate / GitHub Action'
  ci  -> registries 'publishes release artifacts to'
  alintBin -> repo 'reads files + git history; reports violations'
  lspd -> repo 'validates the open workspace'
  xtask -> site 'produces the docs bundle consumed by'
  dev -> editor 'edits the repo in'
  editor -> lspd 'speaks LSP over stdio to'
  ci -> codescan 'uploads SARIF to'
  xtask -> docsbundle 'pushes the docs bundle to'

  // --- Component (crate) runtime edges. Mirror crate-graph.md solid edges;
  //     gated against cargo metadata runtime deps by gen-model --check. ---
  alintBin -> core 'drives the engine'
  alintBin -> dsl 'loads config'
  alintBin -> rules 'registers built-in rules'
  alintBin -> output 'renders reports'
  alintBin -> lspd 'starts the server (alint lsp)'
  dsl -> core 'builds the config AST'
  rules -> core 'implements the Rule trait'
  output -> core 'formats the Report'
  lspd -> core 'runs the engine'
  lspd -> dsl 'validates config'
  lspd -> rules 'registers built-in rules'
  bench -> core 'benchmarks the engine'
  bench -> dsl 'loads configs under bench'
  bench -> output 'formats bench reports'
  bench -> rules 'benchmarks rule evaluation'
  testkit -> core 'builds fixtures against the engine'
  testkit -> dsl 'parses fixture configs'
  testkit -> rules 'exercises rule impls'
  xtask -> bench 'drives bench-release'
  xtask -> core 'reads engine types for docs-export'
  xtask -> rules 'enumerates rules for docs/gen'
}

views {
  // System context. Listed explicitly (not `include *`) so generated
  // domain-model fragments (the rule catalogue, etc.) stay out of the
  // architecture views; they live in their own dedicated views.
  view index {
    title 'alint system context'
    include dev, ci, alint, repo, registries, site, editor, codescan, docsbundle
  }

  view containers of alint {
    title 'alint containers'
    include *
  }

  view cliComponents of cli {
    title 'alint CLI components (crates)'
    include *
  }

  dynamic view checkFlow {
    title 'alint check: execution pipeline'

    dev -> alintBin 'alint check .'
    alintBin -> dsl 'load .alint.yml + resolve extends (cache, cycle-detect, SRI)'
    dsl -> dsl 'reject spawning kinds in extends (ADR-0004)'
    alintBin -> core 'evaluate facts (parallel, cached) + filter rules by when'
    alintBin -> core 'parallel walk -> FileIndex (sorted, deterministic)'
    parallel {
      core -> rules 'per-file dispatch: read each file once -> evaluate_file'
      core -> rules 'rule-major dispatch: cross-file rules scan the index'
    }
    rules -> core 'Violations -> RuleResults -> Report'
    core -> output 'format via selected output (8 formats)'
    output -> dev 'report + exit code'
  }

  dynamic view configLoad {
    title 'Config load + extends trust boundary'

    alintBin -> dsl 'load top-level .alint.yml'
    dsl -> dsl 'resolve extends: local path / https (SRI) / alint://bundled'
    dsl -> dsl 'cache + cycle detection'
    dsl -> dsl 'reject command / generated_file_fresh / command_idempotent in extends'
    dsl -> dsl 'reject allow_out_of_root + custom facts in extends'
    dsl -> dsl 'deep-merge child over parent (per rule id) + schema-validate'
    dsl -> core 'Config AST'
  }

  dynamic view fixFlow {
    title 'alint fix: remediation flow'

    dev -> alintBin 'alint fix'
    alintBin -> core 'evaluate (parallel via rayon)'
    core -> rules 'collect Violations with fixers'
    rules -> core 'apply fixers serially (FixEdit: set / create / delete / rename)'
    core -> core 'FixStatus: Applied / Skipped (over fix_size_limit) / Unfixable'
    core -> output 'fix report + re-check'
  }

  dynamic view dispatchFlow {
    title 'Dispatch partition + read-coalescing'

    core -> core 'partition rules: requires_full_index() -> rule-major; else per-file (ADR-0003)'
    core -> rules 'rule-major: each cross-file rule scans the FileIndex itself'
    core -> core 'file-major loop: read each matched file at most once'
    core -> rules 'per-file: hand the byte slice to every applicable PerFileRule'
    rules -> core 'Violations from both classes, merged + sorted (deterministic)'
  }

  dynamic view factsFlow {
    title 'Facts evaluation + when gating'

    alintBin -> core 'evaluate facts in parallel (any_file_exists, count_files, custom, ...)'
    core -> core 'cache fact values keyed on input hashes'
    core -> core 'evaluate each rule when: clause over facts / vars / ctx'
    core -> core 'drop rules whose when is false'
    core -> rules 'run only the surviving rules'
  }

  dynamic view lspFlow {
    title 'LSP: editor integration'

    editor -> lspd 'initialize / didOpen / didChange (LSP over stdio)'
    lspd -> dsl 'validate the .alint.yml config'
    lspd -> core 'run_for_file: engine over the open document'
    core -> rules 'evaluate the applicable rules'
    rules -> lspd 'Violations'
    lspd -> editor 'publishDiagnostics + hover + code actions (fixes)'
  }

  dynamic view ciActionFlow {
    title 'CI: GitHub Action + SARIF'

    ci -> alintBin 'composite action: install the binary + alint check --format sarif'
    alintBin -> repo 'lint the checked-out repository'
    alintBin -> ci 'SARIF report + exit code (fail the job on error)'
    ci -> codescan 'upload-sarif -> Code Scanning annotations'
  }

  dynamic view docsAsCodeFlow {
    title 'Docs as code: bundle + drift gates'

    xtask -> xtask 'gen-schema / gen-facts / gen-arch / gen-model --check (CI freshness gates)'
    xtask -> docsbundle 'docs-export builds + pushes the bundle'
    docsbundle -> site 'Cloudflare deploy hook -> alint.org rebuild'
    site -> site 'sync-from-alint + internal-link / claim / meta-description gates'
  }
}

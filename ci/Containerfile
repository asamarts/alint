FROM debian:bookworm-slim

ARG RUNNER_VERSION=2.336.0
ARG RUST_VERSION=stable
ARG HYPERFINE_VERSION=1.20.0

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    libssl-dev \
    pkg-config \
    libicu72 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Benchmark output records hyperfine in its reproducibility fingerprint. Keep
# the runner image on the same explicit version as bench-record.yml instead of
# inheriting Debian bookworm's older package.
RUN DPKG_ARCH=$(dpkg --print-architecture) \
    && case "$DPKG_ARCH" in \
         amd64) HF_ARCH=x86_64; HF_SHA256=af844f82e92e6ef206e0115b36742c8c79ad0a8ff39e10601c25e71d76048e2f ;; \
         arm64) HF_ARCH=aarch64; HF_SHA256=90875cb1db7a1d797c311174d061728361e58fc70e3b62262a00635ac3b1997c ;; \
         *) echo "unsupported architecture: $DPKG_ARCH" >&2; exit 1 ;; \
       esac \
    && HF_DIR="hyperfine-v${HYPERFINE_VERSION}-${HF_ARCH}-unknown-linux-gnu" \
    && curl -fsSL -o /tmp/hyperfine.tar.gz \
       "https://github.com/sharkdp/hyperfine/releases/download/v${HYPERFINE_VERSION}/${HF_DIR}.tar.gz" \
    && echo "${HF_SHA256}  /tmp/hyperfine.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/hyperfine.tar.gz -C /tmp \
    && install -m 0755 "/tmp/${HF_DIR}/hyperfine" /usr/local/bin/hyperfine \
    && rm -rf /tmp/hyperfine.tar.gz "/tmp/${HF_DIR}" \
    && hyperfine --version | grep -F "${HYPERFINE_VERSION}"

# Node.js 22 — for `npx likec4 validate` of the architecture model
# (ci/scripts/likec4.sh, called from ci/scripts/docs.sh). bookworm's apt nodejs
# (18.x) is too old for LikeC4, so pull 22.x from NodeSource. NOTE: adding this
# requires a runner image rebuild (teardown/setup) to take effect; until then
# likec4.sh detects the missing node and skips with a warning.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain ${RUST_VERSION} \
    && rustup component add clippy rustfmt

# Cargo subcommands used by ci/scripts/
RUN cargo install --locked cargo-audit

# Create non-root runner user
RUN useradd -m -d /home/runner -s /bin/bash runner

# Install GitHub Actions runner agent
WORKDIR /home/runner/actions-runner
RUN DPKG_ARCH=$(dpkg --print-architecture) \
    && case "$DPKG_ARCH" in amd64) ARCH=x64 ;; arm64) ARCH=arm64 ;; *) ARCH="$DPKG_ARCH" ;; esac \
    && curl -fsSL -o runner.tar.gz \
       "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${ARCH}-${RUNNER_VERSION}.tar.gz" \
    && tar xzf runner.tar.gz \
    && rm runner.tar.gz \
    && ./bin/installdependencies.sh \
    && chown -R runner:runner /home/runner \
    && chown -R runner:runner /usr/local/cargo /usr/local/rustup

COPY runner/entrypoint.sh /home/runner/entrypoint.sh
RUN chmod +x /home/runner/entrypoint.sh

USER runner
WORKDIR /home/runner/actions-runner

ENTRYPOINT ["/home/runner/entrypoint.sh"]

# Canonical GitHub Action pin shown in alint's copy-paste documentation.
#
# A release tag's commit SHA cannot be embedded in that same commit, so this
# file is updated in the post-release documentation follow-up. The version may
# therefore intentionally trail Cargo.toml briefly while the next release is
# being prepared. `check-version-pins.sh` validates the SHA against the tag and
# validates every documented snippet against this file.
ACTION_DOC_VERSION=0.22.0
ACTION_DOC_SHA=8d7a60f6642cb1b59537202ae81df7d951a078ad
# v0.18.0 is the first release whose tagged action.yml carries
# ALINT_BAKED_VERSION, so documented snippets pin with the SHA alone.
ACTION_DOC_REQUIRES_EXPLICIT_VERSION=false
